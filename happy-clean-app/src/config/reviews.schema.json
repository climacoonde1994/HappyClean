{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Happy Clean customer reviews",
  "type": "object",
  "required": [
    "reviews"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "reviews": {
      "type": "array",
      "description": "Real customer reviews, newest first.",
      "items": {
        "type": "object",
        "required": [
          "product",
          "stars",
          "name",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "product": {
            "type": "string",
            "description": "The product id from src/config/products.json, e.g. lemon, calamansi or apple",
            "pattern": "^[a-z0-9-]+$"
          },
          "stars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Rating from 1 to 5"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Customer name as shown on the site, e.g. Maria S."
          },
          "city": {
            "type": "string",
            "description": "Optional. Leave empty to hide."
          },
          "date": {
            "type": "string",
            "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
            "description": "Optional. Format YYYY-MM-DD, e.g. 2026-10-27. Leave empty to hide."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The review in the customer's words (translated to English if needed)."
          }
        }
      }
    }
  }
}